# Copy this file to .env and fill in your own values.

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pichan

# Password required to log into the admin panel and make edits.
# The frontend sends it back as a bearer token on every write request.
# This is a shared-secret scheme, not a real user/session system.
ADMIN_PASSPHRASE=pichan-admin

# Port the API server listens on
PORT=4000

# Comma-separated list of origins allowed to call this API (your frontend's dev/prod URL)
CORS_ORIGIN=http://localhost:5173
